{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil privado del usuario con su ciudad, estado y categorías personalizadas.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "customCategories": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "city", "state", "customCategories", "updatedAt"]
    },
    "Listing": {
      "title": "Listing",
      "description": "Publicación de producto en el marketplace venezolano.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sellerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sellerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 600
        },
        "priceUsd": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "condition": {
          "type": "string",
          "enum": ["Nuevo", "Como nuevo", "Usado"]
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 350000
        },
        "status": {
          "type": "string",
          "enum": ["active", "sold"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "sellerId",
        "sellerName",
        "title",
        "description",
        "priceUsd",
        "category",
        "condition",
        "state",
        "city",
        "lat",
        "lng",
        "imageUrl",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Conversación directa entre comprador y vendedor sobre una publicación.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listingId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listingTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "listingPrice": {
          "type": "number"
        },
        "listingImage": {
          "type": "string",
          "maxLength": 350000
        },
        "buyerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "buyerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sellerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sellerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "participantIds": {
          "type": "array"
        },
        "lastMessage": {
          "type": "string",
          "maxLength": 300
        },
        "lastMessageAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "listingId",
        "listingTitle",
        "listingPrice",
        "listingImage",
        "buyerId",
        "buyerName",
        "sellerId",
        "sellerName",
        "participantIds",
        "lastMessage",
        "lastMessageAt",
        "createdAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Mensaje individual dentro de un chat comprador-vendedor.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantIds": {
          "type": "array"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "senderId", "participantIds", "text", "createdAt"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Registro de compra realizada por un usuario.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listingId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listingTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "listingImage": {
          "type": "string",
          "maxLength": 350000
        },
        "priceUsd": {
          "type": "number"
        },
        "buyerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sellerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sellerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "enum": ["completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "listingId",
        "listingTitle",
        "listingImage",
        "priceUsd",
        "buyerId",
        "sellerId",
        "sellerName",
        "city",
        "state",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfil y categorías personalizadas del usuario."
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Catálogo público de publicaciones del marketplace."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Hilos de chat comprador-vendedor."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Mensajes de cada hilo de chat."
    },
    "/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Historial de compras entre comprador y vendedor."
    }
  }
}
